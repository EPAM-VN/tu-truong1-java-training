{
  "type": "record",
  "namespace": "local.jt.pet.order.web.messaging.customers.events",
  "name": "CustomerPayload",
  "fields": [
    {
      "name": "customerId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "firstName",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "lastName",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "dateOfBirth",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "identifier",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "email",
      "type": "string"
    },
    {
      "name": "active",
      "type": "boolean"
    },
    {
      "name": "membership",
      "type": "local.jt.pet.order.web.messaging.customers.events.Membership"
    },
    {
      "name": "addresses",
      "type": {
        "type": "array",
        "items": "local.jt.pet.order.web.messaging.customers.events.Address"
      },
      "default": []
    }
  ]
}